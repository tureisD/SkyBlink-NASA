# Frontend runtime configuration (copy to `.env.local` to override).

# API prefix. `/api/v1` works with the Vite proxy in development and the
# same-origin FastAPI deployment in production. Set an absolute URL such as
# https://skyblink.example.com/api/v1 when the frontend is hosted separately.
VITE_API_BASE=/api/v1

# Observation data always comes from the API. Mock data modes are unsupported.
