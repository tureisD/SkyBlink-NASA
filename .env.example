# SPHEREx SkyBlink — backend/runtime environment template.
# Export these variables in your shell/container. A plain Python launcher does
# not automatically load this file; use an explicit environment-file loader if needed.
# The API contract version is code-owned (`backend/models/version.py`) and is
# not configured here.

# --- Storage -----------------------------------------------------------------
# Retained inputs, products and replay lineage. Back up before cleanup.
# The Docker image uses /data/cache.
CACHE_DIR=backend/.cache
# Committed golden cache (revision 3): manifests, WebP frames, spectra,
# telemetry sidecars, real SkyView overlays, Gaia pins.
GOLDEN_CACHE_DIR=golden_cache
# Built frontend mounted at / by scripts/serve.py (production one-origin mode).
SPHEREX_FRONTEND_DIST=frontend/dist

# --- Upstream services -------------------------------------------------------
IRSA_TAP=https://irsa.ipac.caltech.edu/TAP
IRSA_SIA2=https://irsa.ipac.caltech.edu/SIA
IRSA_CUTOUT_BASE=https://irsa.ipac.caltech.edu/

# --- Catalog/golden pipeline -------------------------------------------------
MAX_WORKERS=8
# Candidate visit bound; matched image products select one exposure per band/epoch.
MAX_VISITS_PER_BAND=3
# Cache TTL setting (24 h); not an automatic deletion policy.
# Archive mode bypasses product/input cache reads.
CACHE_TTL_SECONDS=86400
# Dense golden spectra: up to 12 visits per band/epoch (max 72 channels/epoch).
SPECTRUM_MAX_VISITS_PER_BAND=12
# Arbitrary-coordinate spectra stay bounded to 1 visit/band.
SPECTRUM_LIVE_MAX_VISITS_PER_BAND=1
SPECTRUM_LIVE_TIMEOUT_SECONDS=90.0

# --- Bounded live arbitrary-coordinate path ---------------------------------
# Best-effort discovery and downloads share a 120-second sky budget.
# Timeouts do not guarantee successful discovery or a comparable pair.
LIVE_RETRIES=3
LIVE_RETRY_BACKOFF_SECONDS=0.25
LIVE_CONNECT_TIMEOUT_SECONDS=10.0
LIVE_REQUEST_TIMEOUT_SECONDS=20.0
LIVE_TAP_TIMEOUT_SECONDS=60.0
LIVE_SKY_DEADLINE_SECONDS=120.0
# Candidate epoch bound; not a promised number of returned epochs.
LIVE_SKY_MAX_EPOCHS=3

# --- Process-local build admission (no automatic deletion or hard quota) -----
LIVE_MAX_ACTIVE_BUILDS=2
RUNTIME_STORAGE_BUDGET_BYTES=8589934592
RUNTIME_MIN_FREE_BYTES=1073741824
LIVE_BUILD_RESERVATION_BYTES=536870912

# --- Full/catalog IRSA timeouts ---------------------------------------------
REQUEST_TIMEOUT_SECONDS=60.0
TAP_TIMEOUT_SECONDS=120.0
IRSA_RETRIES=4
IRSA_RETRY_BACKOFF_SECONDS=1.5

# --- Server / logging --------------------------------------------------------
PORT=8000
HOST=0.0.0.0
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO
# Development origins; production is same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
